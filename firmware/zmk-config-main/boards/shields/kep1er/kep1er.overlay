/* Keycool 84 (Kepler) on nice!nano, pins taken from the KiCad PCB. */

#include <dt-bindings/zmk/matrix_transform.h>
#include "kep1er-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&gpio0 6 GPIO_ACTIVE_HIGH>   /* col0  TX0/P0.06 */
            , <&gpio0 8 GPIO_ACTIVE_HIGH>   /* col1  RX1/P0.08 */
            , <&gpio0 17 GPIO_ACTIVE_HIGH>   /* col2  P0.17 */
            , <&gpio0 20 GPIO_ACTIVE_HIGH>   /* col3  P0.20 */
            , <&gpio0 22 GPIO_ACTIVE_HIGH>   /* col4  P0.22 */
            , <&gpio0 24 GPIO_ACTIVE_HIGH>   /* col5  P0.24 */
            , <&gpio1 0 GPIO_ACTIVE_HIGH>   /* col6  P1.00 */
            , <&gpio0 11 GPIO_ACTIVE_HIGH>   /* col7  P0.11 */
            , <&gpio1 4 GPIO_ACTIVE_HIGH>   /* col8  P1.04 */
            , <&gpio1 6 GPIO_ACTIVE_HIGH>   /* col9  P1.06 */
            , <&gpio0 9 GPIO_ACTIVE_HIGH>   /* col10  NFC1/P0.09 */
            , <&gpio0 10 GPIO_ACTIVE_HIGH>   /* col11  NFC2/P0.10 */
            ;

        row-gpios
            = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row0  P1.11 */
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row1  P1.13 */
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row2  P1.15 */
            , <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row3  P0.02 */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row4  P0.29 */
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row5  P0.31 */
            , <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row6  P1.07 (extra pad) */
            ;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <7>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7) RC(5,8) RC(5,9) RC(5,10) RC(5,11)
            RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5) RC(6,6) RC(6,7) RC(6,8) RC(6,9) RC(6,10) RC(6,11)
        >;
    };

    /* Rotary encoder: A = P1.01, B = P1.02, common (C) goes to GND on the PCB. */
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        b-gpios = <&gpio1 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};
